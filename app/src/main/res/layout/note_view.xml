<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barre du haut avec l'icône du menu burger -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barre_outils"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#615F5F"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_edition"
        app:navigationIcon="@drawable/chevron_backward"
        app:navigationIconTint="#FFFFFF"
        app:titleTextColor="#BCBCBC" />


    <EditText
        android:id="@+id/editContenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:gravity="top"
        android:hint="Écrire votre note..."
        android:inputType="textMultiLine|textCapSentences"
        app:layout_constraintTop_toBottomOf="@id/editNom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <EditText
        android:id="@+id/editNom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Titre de la note"
        android:inputType="textCapSentences"
        app:layout_constraintTop_toBottomOf="@id/barre_outils"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>